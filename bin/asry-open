#!/usr/bin/env bash
# asry-open —— 在浏览器里打开 Agent Sessionary（网页版，窗口自由缩放）
#
# 用法：
#   asry-open                  独立无地址栏大窗口（默认，推荐）
#   asry-open --tab            退回普通浏览器标签页
#   asry-open --tool=claude    只打开 claude 的会话
#   asry-open --q=关键词        打开并预先搜索
#   ASRY_WIN_W=1600 ASRY_WIN_H=900 asry-open
#
# 服务侧：不活就拉起来。优先 systemctl --user start（能长期常驻），
# 失败则直接起进程兜底，保证双击图标永远有结果。
#
# 踩坑记录（2026-11-22 实测）：
#   1. sandbox 把 uid 映射为 0 → Chrome 报 "Running as root without --no-sandbox"，起不来
#   2. 用默认 profile 启 --app 会静默失败（无窗口、无报错），必须独立 --user-data-dir
#   3. root/容器下 GPU 初始化崩（exit_code=8704）→ 必须 --disable-gpu
#   4. 从 WorkBuddy sandbox 起的 GUI 进程会随命令返回被杀 → 日常请点桌面图标

set -uo pipefail

PORT="${ASRY_PORT:-8347}"
BASE="http://127.0.0.1:${PORT}"
PROFILE_DIR="${ASRY_PROFILE:-$HOME/.cache/asry-chrome}"

# ---- 定位项目目录 ----
# 本脚本会被 install.sh 复制到 ~/.local/bin 去全局调用，所以不能写死项目路径。
# 依次尝试：环境变量 → 符号链接/实际位置的上层目录 → 安装时记录的路径。
resolve_app_dir() {
  if [ -n "${ASRY_HOME:-}" ] && [ -f "$ASRY_HOME/agent-sessionary-server.js" ]; then
    printf '%s' "$ASRY_HOME"; return 0
  fi
  local self cand
  self="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
  cand="$(cd "$(dirname "$self")/.." 2>/dev/null && pwd)"
  if [ -n "$cand" ] && [ -f "$cand/agent-sessionary-server.js" ]; then
    printf '%s' "$cand"; return 0
  fi
  cand="$HOME/.config/agent-sessionary/appdir"
  if [ -f "$cand" ]; then
    cand="$(cat "$cand")"
    if [ -f "$cand/agent-sessionary-server.js" ]; then printf '%s' "$cand"; return 0; fi
  fi
  return 1
}

APP_DIR="$(resolve_app_dir)" || APP_DIR=""
SERVER_JS="$APP_DIR/agent-sessionary-server.js"

QS=""; MODE="app"
for arg in "$@"; do
  case "$arg" in
    --tool=*) QS="${QS:+$QS&}tool=${arg#*=}" ;;
    --q=*)    QS="${QS:+$QS&}q=${arg#*=}" ;;
    --app)    MODE="app" ;;
    --tab)    MODE="tab" ;;
  esac
done
URL="$BASE/"
[ -n "$QS" ] && URL="$BASE/?$QS"

# ---- 1) 服务探活，不活就拉起来 ----
alive() { curl -s -o /dev/null --max-time 2 "$BASE/api/models"; }

if ! alive; then
  echo "Agent Sessionary 未运行，正在启动…"
  # 首选 systemd：能常驻、能开机自启、崩溃自动重启
  if ! systemctl --user start asry.service 2>/dev/null; then
    # 兜底：systemd 不可用（比如在 sandbox 里）就直接起进程
    if [ -x "$HOME/.local/bin/asry-service" ]; then
      setsid "$HOME/.local/bin/asry-service" >/dev/null 2>&1 &
    elif [ -n "$SERVER_JS" ] && [ -f "$SERVER_JS" ] && command -v node >/dev/null 2>&1; then
      setsid node "$SERVER_JS" >/dev/null 2>&1 &
    fi
  fi
  for _ in $(seq 1 30); do alive && break; sleep 0.5; done
fi

if ! alive; then
  # 弹窗提示比静默退出有用
  msg="Agent Sessionary 启动失败：$BASE 无响应\n\n排查：journalctl --user -u agent-sessionary -n 50 --no-pager"
  if command -v zenity >/dev/null 2>&1; then
    zenity --error --text="$msg" 2>/dev/null &
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "Agent Sessionary" "$msg" 2>/dev/null
  fi
  echo -e "$msg" >&2
  exit 1
fi

echo "Agent Sessionary: $URL"

# ---- 2) 桌面环境（桌面会话里通常已有，缺失才补）----
if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
  for d in :0 :1 :2; do
    [ -S "/tmp/.X11-unix/X${d#:}" ] && export DISPLAY="$d" && break
  done
fi
[ -z "${XAUTHORITY:-}" ] && [ -f /run/user/1000/gdm/Xauthority ] && \
  export XAUTHORITY=/run/user/1000/gdm/Xauthority
[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S /run/user/1000/bus ] && \
  export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

WIN_W="${ASRY_WIN_W:-1900}"
WIN_H="${ASRY_WIN_H:-1150}"

APP_FLAGS=(
  --user-data-dir="$PROFILE_DIR"
  --window-size="${WIN_W},${WIN_H}"
  --window-position=40,30
  --no-first-run --no-default-browser-check
  --disable-gpu --disable-dev-shm-usage
)

launch_app() {
  local browser="$1"
  mkdir -p "$PROFILE_DIR"
  nohup "$browser" "${APP_FLAGS[@]}" --app="$URL" --class=AgentSessionary \
    >"$PROFILE_DIR/launch.log" 2>&1 &
}

MYUID="$(id -u)"

# --- 真实桌面用户（uid != 0）：直接起，落到自己桌面会话 ---
if [ "$MYUID" != "0" ]; then
  if [ "$MODE" = "app" ]; then
    for b in google-chrome google-chrome-stable chromium chromium-browser; do
      command -v "$b" >/dev/null 2>&1 && { launch_app "$b"; exit 0; }
    done
  fi
  command -v xdg-open >/dev/null 2>&1 && { setsid xdg-open "$URL" >/dev/null 2>&1 & exit 0; }
fi

# --- sandbox（uid 0）：unshare 还原成 1000 再起 ---
for browser in google-chrome google-chrome-stable chromium chromium-browser; do
  command -v "$browser" >/dev/null 2>&1 || continue
  if command -v unshare >/dev/null 2>&1; then
    unshare --user --map-user=1000 --map-group=1000 -- \
      env DISPLAY="${DISPLAY:-}" XAUTHORITY="${XAUTHORITY:-}" \
          DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-}" \
          HOME="$HOME" ASRY_BROWSER="$browser" MODE="$MODE" \
          URL="$URL" PROFILE_DIR="$PROFILE_DIR" \
      bash -c "$(declare -f launch_app); APP_FLAGS=($(printf '%q ' "${APP_FLAGS[@]}")); \
               if [ \"\$MODE\" = app ]; then launch_app \"\$ASRY_BROWSER\"; \
               else setsid \"\$ASRY_BROWSER\" \"\$URL\" >/dev/null 2>&1 & fi" \
      >/dev/null 2>&1
  else
    launch_app "$browser"
  fi
  exit 0
done

if command -v xdg-open >/dev/null 2>&1; then
  setsid xdg-open "$URL" >/dev/null 2>&1 &
  exit 0
fi

echo "没找到可用浏览器，请手动打开：$URL" >&2
exit 1
