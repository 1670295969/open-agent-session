node_modules/

# 日志与临时产物
*.log
*.tmp
.DS_Store
Thumbs.db

# 编辑器
.vscode/
.idea/
*.swp

# Python 字节码（tools/make-icon.py 跑起来会生成）
__pycache__/
*.py[cod]

